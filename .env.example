# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Cal.com
CAL_API_KEY=your_cal_api_key_here
CAL_EVENT_TYPE_ID=your_cal_event_type_id_here
CAL_EVENT_TYPE_ID_MTB=5145953
CAL_EVENT_TYPE_ID_PAVED_SANFORD=5398819
CAL_EVENT_TYPE_ID_PAVED_BLUE_SPRING=5398892
CAL_USERNAME=floridamountainbikeguides

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your_cron_secret_here
ADMIN_SECRET=your_admin_secret_here
# Extra /admin accounts besides the owner (lib/admin-auth.ts), comma-separated.
# Each needs a Supabase Auth user with a password (Dashboard → Authentication → Users).
ADMIN_EMAILS=

# n8n
N8N_WEBHOOK_URL=your_n8n_webhook_url_here
N8N_REMAINING_BALANCE_WEBHOOK_URL=https://fmbgt-n8n.yvjziu.easypanel.host/webhook/remaining-balance

# Senzai
SENZAI_INGEST_URL=https://senzai-v1.vercel.app/
SENZAI_CONNECTION_KEY=your_senzai_connection_key_here
SENZAI_CONNECTION_SECRET=your_senzai_connection_secret_here

# Customer emails through Kigaru (docs/email-via-kigaru.md). The email types the
# app hands to the Kigaru hub instead of n8n, comma-separated, or * for all:
#   booking_confirmed, remaining_balance_paid, remaining_balance_failed,
#   lead_follow_up, review_request
# Empty = everything still goes through n8n. Needs a redeploy to take effect.
# Outside production only *@resend.dev addresses are ever sent.
KIGARU_EMAIL_TYPES=

# Trail map basemap (components/map/InteractiveTrailMap.jsx). CARTO now requires a
# key — without one the map falls back to plain OpenStreetMap tiles. Free for
# commercial use up to 1M tile requests/month: https://carto.com/basemaps/apikey
# Public by design: it ships in every tile URL the browser requests.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=

# Reviews
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/CT9a-OQuagz4EAE/review

# Tracking and Analytics (Blueprint §20 — required before launch)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-SMP4GWTYJW
# GA4 Measurement Protocol API secret — enables the SERVER-SIDE GA4 purchase from the
# Stripe webhook (lib/ga4-mp.ts). Create at GA4 Admin → Data Streams → (your web
# stream) → Measurement Protocol API secrets. Without it the server purchase is
# skipped (browser-only, lossy).
GA4_API_SECRET=your_ga4_measurement_protocol_api_secret_here
# NEXT_PUBLIC_GTM_ID=G-XXXXXXXXXX        # Phase 3: add when GTM container is ready
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXX
META_PIXEL_ID=XXXXXXXXXX
META_ACCESS_TOKEN=your_meta_conversions_api_access_token_here
META_API_VERSION=vXX.X
# META_TEST_EVENT_CODE=TESTXXXXX
